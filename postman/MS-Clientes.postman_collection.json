  },
  "item": [
    {
      "name": "1. GET - Listar Todos los Clientes (200 OK - Descuenta 1 Token)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{msBaseUrl}}/api/clientes",
          "host": [
            "{{msBaseUrl}}"
          ],
          "path": [
            "api",
            "clientes"
          ]
        },
        "description": "Consulta general de clientes. Descuenta exactamente 1 token de la cuota del usuario autorizado."
      },
      "response": []
    },
